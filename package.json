{
  "name": "pvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm start --workspace=@pvp/game",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "E2E=1 node --test apps/game/test/e2e/*.test.js"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
